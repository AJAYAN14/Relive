    <!-- Privacy Screen -->
    <string name="settings_privacy_sec1_title">Local Processing</string>
    <string name="settings_privacy_sec1_content">Relive processes all your photos and videos completely on your device. We do not upload your media to any server or cloud storage.</string>
    <string name="settings_privacy_sec2_title">Storage Permission</string>
    <string name="settings_privacy_sec2_content">Media read permissions are only used to load photos and videos in your gallery. Silent deletion or file moving requires file access permission.</string>
    <string name="settings_privacy_sec3_title">On-device AI Analysis</string>
    <string name="settings_privacy_sec3_content">Image classification, similarity analysis, and face detection are executed locally using Google ML Kit. No facial data or analysis metadata leaves your device.</string>
    <string name="settings_privacy_sec4_title">Zero Data Collection</string>
    <string name="settings_privacy_sec4_content">We do not collect personal identifying information, tracking IDs, or analytics. Your photos belong to you only.</string>

